{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatbot-rag",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // pg (driver do Postgres) precisa das APIs de Node que esta flag liga.
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI: o modelo é chamado por env.AI, sem token nenhum.
  "ai": { "binding": "AI" },

  // Hyperdrive: a conexão com o Neon. O "id" NÃO é segredo (a string do banco fica na Cloudflare).
  // Troque pelo id que o `wrangler hyperdrive create` mostrou (ver README, "Deploy").
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "06b019454c3d47db97ca3bc599dd6508" }],

  // A página (apps/web, gerada por `npm run build`) é servida pela Cloudflare.
  // Só /api/* chega ao Worker; o resto é arquivo estático.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },

  "vars": {
    "NODE_ENV": "production",
    // A Cloudflare define este cabeçalho com o IP real: pode confiar (o cliente não consegue forjar).
    "IP_HEADER": "cf-connecting-ip",
  },

  "observability": { "enabled": true },
}
