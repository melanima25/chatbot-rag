# Copie para .env (o .env NUNCA vai para o Git).
DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot

# "fake" = embeddings de mentira, locais e determinísticos (não precisa de conta nenhuma).
# "workers-ai" = embeddings reais do Cloudflare Workers AI (precisa das duas variáveis abaixo).
EMBEDDING_PROVIDER=fake

# Só para EMBEDDING_PROVIDER=workers-ai. O token deve ter SOMENTE a permissão "Workers AI".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Respostas do chatbot: "fake" (texto fixo de teste) ou "workers-ai" (modelo real).
LLM_PROVIDER=fake
# LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast

# Calibração (valores padrão; ver docs/calibracao-limiar.md)
# SIMILARIDADE_MINIMA=0.55
# TOP_K=4
# MAX_TOKENS_RESPOSTA=300

# Limites de uso (valores padrão; ver README, "Limites de uso")
# LIMITE_POR_MINUTO=8
# LIMITE_POR_HORA=60
# LIMITE_PERGUNTAS_CONVERSA=20
# ORCAMENTO_TOKENS_DIA=1200000

# Só com proxy de confiança na frente (ex.: Cloudflare): cabeçalho que traz o IP real.
# Sem proxy de confiança, NÃO defina: um cabeçalho qualquer pode ser forjado pelo cliente.
# IP_HEADER=cf-connecting-ip

# Páginas autorizadas a chamar a API pelo navegador (CORS), separadas por vírgula, sem barra no fim.
# CORS_ORIGENS=http://localhost:5173,https://demo.exemplo.com
