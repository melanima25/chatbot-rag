# Copie para .env (o .env NUNCA vai para o Git).
DATABASE_URL=postgres://chatbot:chatbot@localhost:5432/chatbot

# "fake" = embeddings de mentira, locais e determinísticos (não precisa de conta nenhuma).
# "workers-ai" = embeddings reais do Cloudflare Workers AI (precisa das duas variáveis abaixo).
EMBEDDING_PROVIDER=fake

# Só para EMBEDDING_PROVIDER=workers-ai. O token deve ter SOMENTE a permissão "Workers AI".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
